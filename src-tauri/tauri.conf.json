{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NFAStore Tool",
  "version": "1.5.0",
  "identifier": "ir.nfastore.tool",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "NFAStore Tool",
        "width": 900,
        "height": 620,
        "minWidth": 720,
        "minHeight": 500,
        "resizable": true,
        "center": true,
        "decorations": false,
        "theme": "Dark",
        "backgroundColor": "#0F0F0F"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "resources": ["binaries/cs2-rank-sidecar.exe"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/256x256.png",
      "icons/512x512.png",
      "icons/icon.ico"
    ]
  }
}
